#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ai-gateway
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 停止进程
	if [ -n "$(pgrep -f ai-gateway)" ]; then
		kill $(pgrep -f ai-gateway)
	fi
}

restart() {
	stop
	sleep 1
	start
}

reload_service() {
	restart
}

status_service() {
	if [ -n "$(pgrep -f ai-gateway)" ]; then
		echo "running"
		return 0
	else
		echo "stopped"
		return 3
	fi
}