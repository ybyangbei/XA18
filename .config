# ============================================================
# CMIOT AX18 (IPQ6018/IPQ6000 + NAND) 编译配置
# 源码: LibWrt/LibWrt  branch 25.12-nss (OpenWrt 25.12 + NSS 满血加速)
# RAM : 已人工改装 1GB —— 设备树不写死 memory 节点，u-boot 经 SMEM
#       自动探测内存大小，无需设备树补丁；首刷后用 `free` 验证即可
# WiFi: 全部禁用（无无线需求）
# 产物: libwrt-qualcommax-ipq60xx-cmiot_ax18-squashfs-sysupgrade.bin
#       libwrt-qualcommax-ipq60xx-cmiot_ax18-squashfs-factory.ubi
# ============================================================

# ---------- 目标平台 / 设备 ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_cmiot_ax18=y

# ---------- LuCI 界面 + 简体中文 ----------
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

# ---------- NSS 硬件加速 ----------
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-nss-ifb=y

# ---------- WiFi 全禁 ----------
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set

# ---------- 代理 ----------
CONFIG_PACKAGE_luci-app-openclash=y

# ---------- DNS 加速 ----------
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y

# ---------- 系统辅助 ----------
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

# ---------- NAS / USB ----------
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y

# ---------- 工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_iperf3=y
