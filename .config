# ============================================================
# CMIOT AX18 (和目 AX18) - coolsnowwolf/lede 云编译种子配置
# 平台: qualcommax / ipq60xx / cmiot_ax18 (IPQ6000)
# 说明: 工作流会在编译前执行 make defconfig 自动补全其余默认项。
#       带 "# 可选:" 的条目默认不启用；取消注释前请确认包存在，
#       不存在的包会被 defconfig 忽略，不会导致编译失败。
# ============================================================

# ---------- 目标平台 (Target System / Subtarget / Profile) ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_cmiot_ax18=y

# ---------- LuCI Web 界面 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y

# ---------- LuCI 常用应用 ----------
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ntpc=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-flowoffload=y
CONFIG_PACKAGE_luci-app-ttyd=y

# ---------- DNS / 网络组件 ----------
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_libipset=y
CONFIG_PACKAGE_kmod-tun=y

# ---------- 传输 / 系统工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y

# ---------- 存储 / 挂载 (该机为 NAND，无 USB 口) ----------
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y

# ============================================================
# 可选插件（默认注释，按需启用）
# ============================================================
# 科学上网：lede 默认已含 helloworld feed（luci-app-ssr-plus 等）
# CONFIG_PACKAGE_luci-app-ssr-plus=y
# 代理全家桶（passwall；若 lede luci feed 未收录需自行添加 feed，见 README §6.2）
# CONFIG_PACKAGE_luci-app-passwall=y
# 内网穿透 (ZeroTier，已启用；依赖 kmod-tun，见上方已启用)
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_zerotier=y
# 智能 DNS（如需启用，取消注释）
# CONFIG_PACKAGE_luci-app-smartdns=y
# CONFIG_PACKAGE_smartdns=y
# 文件共享（256MB 内存，请评估后启用）
# CONFIG_PACKAGE_luci-app-samba4=y

# ============================================================
# 无线 WiFi —— 已取消需求（重要）
# 1) LEDE qualcommax/ipq60xx 的 DEFAULT_PACKAGES 默认含
#    kmod-ath11k-ahb / ath11k-firmware-ipq6018 / wpad-openssl；
#    不显式禁用会被 defconfig 自动启用，故在此全部置为 is not set。
# 2) 原版 lede 设备树中 AX18 WiFi 节点 status="disabled"，
#    ipq-wifi 包也无 cmiot_ax18 板卡数据（见 README §4）→ 固件无 WiFi。
# 3) 如需 WiFi：把工作流 REPO_URL 改为
#    https://github.com/AnClark/lede-zn-m2-wifi 并移除下方禁用项。
# ============================================================
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set
# CONFIG_PACKAGE_wpad-openssl is not set
