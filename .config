# ============================================================
# CMIOT AX18 (和目 AX18) - coolsnowwolf/lede 云编译种子配置
# 平台: qualcommax / ipq60xx / cmiot_ax18 (IPQ6000)
# 说明: 工作流会在编译前执行 make defconfig 自动补全其余默认项。
#       带 "# 可选:" 的条目默认不启用；取消注释前请确认包存在，
#       不存在的包会被 defconfig 忽略，不会导致编译失败。
# ============================================================

# ---------- 目标平台 (Target System / Subtarget / Profile) ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_cmiot_ax18=y

# ---------- LuCI Web 界面 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y

# ---------- LuCI 常用应用 ----------
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ntpc=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-flowoffload=y
CONFIG_PACKAGE_luci-app-ttyd=y

# ---------- DNS / 网络组件 ----------
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_libipset=y
CONFIG_PACKAGE_kmod-tun=y

# ---------- 传输 / 系统工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y

# ---------- 存储 / 挂载 (该机为 NAND，无 USB 口) ----------
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y

# ============================================================
# 可选插件（默认注释，按需启用）
# ============================================================
# 科学上网：lede 默认已含 helloworld feed（luci-app-ssr-plus 等）
# CONFIG_PACKAGE_luci-app-ssr-plus=y
# 代理全家桶（passwall；若 lede luci feed 未收录需自行添加 feed，见 README §5.2）
# CONFIG_PACKAGE_luci-app-passwall=y
# 内网穿透 / 智能 DNS
# CONFIG_PACKAGE_luci-app-zerotier=y
# CONFIG_PACKAGE_zerotier=y
# CONFIG_PACKAGE_luci-app-smartdns=y
# CONFIG_PACKAGE_smartdns=y
# 文件共享（256MB 内存，请评估后启用）
# CONFIG_PACKAGE_luci-app-samba4=y

# ============================================================
# WiFi 板卡数据（重要，见 README §4）
# 原版 lede 的 ipq-wifi 包不含 cmiot_ax18 板卡数据，且设备树中
# WiFi 节点默认为 disabled，因此原版固件无 WiFi。
# 如需 WiFi：把工作流 REPO_URL 改为
#   https://github.com/AnClark/lede-zn-m2-wifi
# 若该 fork 未在设备定义中内置此包，可手动启用：
# CONFIG_PACKAGE_ipq-wifi-cmiot_ax18=y
# ============================================================
